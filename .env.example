# --- Required ---------------------------------------------------------------
# Groq API key for whisper-large-v3 transcription (free tier: console.groq.com)
GROQ_API_KEY=

# Shared secret the iOS Shortcut sends as the X-Ingest-Secret header.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_SECRET=

# Long random segment embedded in the MCP URL (the connector URL is the only auth).
# The MCP server is served at /mcp-<MCP_PATH_TOKEN>/mcp
MCP_PATH_TOKEN=

# --- Optional ---------------------------------------------------------------
# Where the SQLite db + extracted frames live. Default: <repo>/data
#DATA_DIR=/Users/you/Desktop/reel-relay/data

# Bind address/port for the local server (keep HOST on localhost; expose via tunnel).
#HOST=127.0.0.1
#PORT=8787

# Let yt-dlp reuse a logged-in browser session for reels that require auth.
# One of: safari, chrome, firefox, edge, brave ...
#YTDLP_COOKIES_FROM_BROWSER=safari
