# --- Required ---------------------------------------------------------------
# Speech-to-text: any OpenAI-compatible /audio/transcriptions endpoint.
# Default is NanoGPT Whisper-Large-V3. (Setting only GROQ_API_KEY keeps the Groq setup.)
STT_API_KEY=
#STT_API_URL=https://nano-gpt.com/api/v1/audio/transcriptions
#STT_MODEL=Whisper-Large-V3
#STT_LANGUAGE=ru
#GROQ_API_KEY=

# Shared secret the iOS Shortcut sends as the X-Ingest-Secret header.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_SECRET=

# Long random segment embedded in the MCP URL (the connector URL is the only auth).
# The MCP server is served at /mcp-<MCP_PATH_TOKEN>/mcp
MCP_PATH_TOKEN=

# --- Optional ---------------------------------------------------------------
# Where the SQLite db + extracted frames live. Default: <repo>/data
#DATA_DIR=/Users/you/Desktop/reel-relay/data

# Bind address/port for the local server (keep HOST on localhost; expose via tunnel).
#HOST=127.0.0.1
#PORT=8787

# Let yt-dlp reuse a logged-in browser session for reels that require auth.
# One of: safari, chrome, firefox, edge, brave ...
#YTDLP_COOKIES_FROM_BROWSER=safari
# ...or a Netscape cookies.txt exported from a secondary account (servers/containers).
#YTDLP_COOKIES_FILE=/secrets/instagram_cookies.txt

# --- Instagram DM webhook (Phase 1, optional) -------------------------------
# Only needed for the "share a reel to a bot Instagram account" ingestion path.
# When both are set, POST/GET /webhook is active (see docs/instagram-webhook.md).
# META_APP_SECRET: from your Meta app > Settings > Basic (verifies request signatures).
#META_APP_SECRET=
# META_VERIFY_TOKEN: any random string you also paste into the Meta webhook config.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#META_VERIFY_TOKEN=

# --- Telegram bot ingestion (optional, MUCH simpler than Meta) --------------
# Share/forward a reel to your bot and it lands in Claude. No app review needed.
# TELEGRAM_BOT_TOKEN: from @BotFather (/newbot).
#TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET: random string; set as Telegram's setWebhook secret_token.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ALLOWED_USER_ID: optional - only accept reels from your own Telegram id.
#TELEGRAM_ALLOWED_USER_ID=
