# reel-relay on the NAS. Copy to /volume1/docker/reel-relay/.env and chmod 600.

# --- Required ---------------------------------------------------------------
# Long random values. Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_SECRET=
MCP_PATH_TOKEN=

# Speech-to-text: NanoGPT, OpenAI-compatible endpoint (billed per minute from balance).
STT_API_KEY=
STT_API_URL=https://nano-gpt.com/api/v1/audio/transcriptions
STT_MODEL=Whisper-Large-V3
# Language hint: most reels are Russian. Leave empty for auto-detect.
STT_LANGUAGE=ru

# Cookies of the SECONDARY Instagram account, Netscape format
# (Chrome extension "Get cookies.txt LOCALLY" -> Export -> Netscape, current site only).
YTDLP_COOKIES_FILE=/secrets/instagram_cookies.txt

# --- Container defaults (normally keep) -------------------------------------
HOST=0.0.0.0
PORT=8787
DATA_DIR=/data
# One job at a time: gentle on Instagram rate limits with a single account.
WORKER_CONCURRENCY=1
# Hosts add_reel may fetch (the MCP URL is the only credential).
ALLOWED_INGEST_HOSTS=instagram.com,www.instagram.com
