# systemd unit for running reel-relay 24/7 on a Linux server (e.g. a free cloud VM).
# Install:
#   sudo cp ops/reel-relay.service /etc/systemd/system/reel-relay.service
#   # edit paths/User below if your checkout isn't /home/ubuntu/reel-relay
#   sudo systemctl daemon-reload && sudo systemctl enable --now reel-relay
# Logs: journalctl -u reel-relay -f
[Unit]
Description=reel-relay FastAPI + MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/reel-relay
ExecStart=/home/ubuntu/.local/bin/uv run uvicorn server.main:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
